{
  "name": "nuts-web-games",
  "version": "0.7.0-rework.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "node scripts/check-i18n.mjs && tsc --noEmit",
    "build": "npm run check && node scripts/build.mjs",
    "build:target": "node scripts/build-target.mjs",
    "preview": "node scripts/serve.mjs",
    "test": "playwright test",
    "integrate": "node scripts/integrate.mjs",
    "art:import": "node scripts/m03-assets.mjs --import",
    "art:export": "node scripts/m03-assets.mjs && node scripts/m05a-art-previews.mjs",
    "art:m06:icons": "node scripts/m06-icon-contact-sheet.mjs",
    "art:refresh": "node scripts/art-refresh-v1.mjs && node scripts/art-refresh-v1-sources.mjs && node scripts/write-art-refresh-records.mjs",
    "art:source": "node scripts/art-refresh-v1-sources.mjs",
    "art:check": "node scripts/check-m03-contract.mjs && node scripts/check-art-refresh-v1.mjs && node scripts/check-rework-assets.mjs",
    "i18n:check": "node scripts/check-i18n.mjs",
    "i18n:export": "node scripts/check-i18n.mjs --export",
    "audio:export": "node scripts/m06-audio.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.10.0",
    "ag-psd": "34.1.0",
    "sharp": "0.35.5",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  }
}
